.square {
    width: 100%;
    height: 0;
    padding-top: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.cost-icon {
    width: 48px;
    height: 48px;
    background-image: url('project://database/Assets/Icon_BG.png?fileID=2800000&guid=55f4616714029ea488683c7e7dafcbe2&type=3#Icon_BG');
    margin-bottom: 3px;
    align-items: center;
    justify-content: center;
}

.cost-icon--requirement {
    background-image: url('project://database/Assets/3rdParty/GUI_Parts/Gui_parts/lil_roundframe_ready.png?fileID=2800000&guid=76a827c0b7b700d4fa9e135b970a64b1&type=3#lil_roundframe_ready');
}

.cost-icon--big {
    width: 52px;
    height: 52px;
    background-image: url('project://database/Assets/3rdParty/64%20flat%20icons/png/64px/Modifiers_LevelUp.png?fileID=21300000&guid=f6155c86d5314024989c1ef8cb0100e5&type=3#Modifiers_LevelUp');
}

.cost-icon-icon {
    width: 60%;
    height: 60%;
    background-image: url('project://database/Assets/3rdParty/64%20flat%20icons/png/64px/Modifiers_Sleep.png?fileID=21300000&guid=f56d5694968bde747892675104a4fb67&type=3#Modifiers_Sleep');
    align-items: center;
    justify-content: center;
}

.color-default-text {
    color: rgb(241, 236, 224);
    -unity-font: url('project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=8378c736dc8127647b9fbabd26844a78&type=3#NotInter-Regular');
}

.text-color-overbudget {
    color: rgb(197, 20, 20);
}

.carditem-selectable:disabled .color-default-text {
    color: rgb(192, 185, 168);
}

.cost-icon--affordable > * {
    -unity-background-image-tint-color: rgb(225, 241, 224);
}

.cost-icon--overbudget > * {
    -unity-background-image-tint-color: rgb(204, 41, 41);
}

.button-menu {
    background-image: url('project://database/Assets/3rdParty/GUI_Parts/Gui_parts/name_bar2.png?fileID=21300000&guid=e4c261293bfe98f4fa9d9591373bc443&type=3#name_bar2');
    height: 75px;
    width: 275px;
    -unity-font-style: bold;
    color: rgb(231, 229, 208);
    font-size: 24px;
}

.button-menu:hover {
    -unity-background-image-tint-color: rgb(233, 229, 201);
}

.button-menu:active {
    scale: 0.95 0.95;
}

.button-menu:disabled {
    background-image: url('project://database/Assets/3rdParty/GUI_Parts/Gui_parts/name_bar3.png?fileID=21300000&guid=12eaceb7341922b4398ff20c8bbcff90&type=3#name_bar3');
    opacity: 1;
}

.carditem-selectable:hover {
    translate: 0 -200px;
    transition-duration: 150ms;
    transition-timing-function: ease-in-out-sine;
    border-left-color: rgb(63, 173, 233);
    border-right-color: rgb(63, 173, 233);
    border-top-color: rgb(63, 173, 233);
    border-bottom-color: rgb(63, 173, 233);
    transition-property: translate;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

.carditem-selectable:hover .helper-playcard {
    display: flex;
}

.carditem-selectable:disabled .helper-playcard {
    display: none;
}

.carditem-selectable:disabled {
    opacity: 1;
    border-left-color: rgb(195, 54, 54);
    border-right-color: rgb(195, 54, 54);
    border-top-color: rgb(195, 54, 54);
    border-bottom-color: rgb(195, 54, 54);
}

.carditem-selectable:disabled #Icon {
    -unity-background-image-tint-color: rgb(125, 125, 125);
}

.resource-panel {
    flex-direction: row;
    justify-content: space-around;
    align-items: flex-start;
}

.resource-panel-group {
    flex-direction: column;
}

.resource-panel--card > .resource-panel-group {
    flex-direction: row;
}

.text-shadow {
    text-shadow: 0 0 3px rgb(0, 0, 0);
}

.text-shadow-strong {
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 0 0 5px rgb(0, 0, 0);
}

.unit-border {
    background-image: url('project://database/Assets/Materials/UnitItem_Border.png?fileID=2800000&guid=a5fccf8732b6e114c9a1c1a6f73d26f0&type=3#UnitItem_Border');
}

.unit-badge--current .unit-border {
    background-image: url('project://database/Assets/Materials/UnitItem_Border_Current.png?fileID=2800000&guid=e9ff12f99fa7cc7408b4297987cc1049&type=3#UnitItem_Border_Current');
}

.unit-badge--hovered {
    translate: 0 15px;
    transition-duration: 200ms;
}

#SkillDisplay #SpeedBackground {
    display: none;
}

#SkillDisplay #CostRow {
    display: none;
}

.helper-playcard {
    display: none;
}

.decklist {
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
    flex-wrap: wrap;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 40px;
    margin-bottom: 40px;
}

TextField > * {
    background-color: rgb(87, 87, 87);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(188, 188, 188);
    border-right-color: rgb(188, 188, 188);
    border-top-color: rgb(188, 188, 188);
    border-bottom-color: rgb(188, 188, 188);
    padding-top: 5px;
    padding-bottom: 5px;
}

.statusbar CardItem {
    width: 42px;
    height: 42px;
}

.statusbar-big CardItem {
    width: 64px;
    height: 64px;
}

UnitItem .statusbar {
    flex-direction: column-reverse;
}
