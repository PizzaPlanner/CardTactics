                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="align-items: center; padding-left: 25px; padding-right: 25px; padding-top: 25px; padding-bottom: 100px;">
                <ui:Button text="Select this Deck" display-tooltip-when-elided="true" name="ChooseDeck" class="button-menu" />
            </ui:VisualElement>
            <ui:Button text="X" display-tooltip-when-elided="true" name="Close" class="button-menu" style="width: 60px; height: 60px; position: absolute; right: 5px; top: 5px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
