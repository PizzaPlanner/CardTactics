<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="UnitItem" src="project://database/Assets/UI/UnitItem.uxml?fileID=9197481963319205126&amp;guid=26805b5f1c472734bbd37880d504ef40&amp;type=3#UnitItem" />
    <ui:Template name="CardBig" src="project://database/Assets/UI/CardBig.uxml?fileID=9197481963319205126&amp;guid=29a9371bab04ae14aa88f1bec4eb9fbc&amp;type=3#CardBig" />
    <Style src="project://database/Assets/UI/card.uss?fileID=7433441132597879392&amp;guid=01a2327da0d399347b2ae61c1337875e&amp;type=3#card" />
    <ui:VisualElement name="PlayerInfo" style="position: absolute; left: 0; top: 0; bottom: 0; justify-content: center; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/big_background.png?fileID=2800000&amp;guid=4edbc5539b441f049966c07e2ba12186&amp;type=3#big_background&apos;);">
        <ui:Instance template="UnitItem" name="UnitItem" />
        <ui:Instance template="UnitItem" name="UnitItem" />
        <ui:Instance template="UnitItem" name="UnitItem" />
        <ui:Instance template="UnitItem" name="UnitItem" />
    </ui:VisualElement>
    <ui:VisualElement name="MidAnchor" style="left: 300px; position: absolute; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center;">
        <ui:VisualElement name="DeckSelect" style="align-items: stretch; width: 80%; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/barmid_ready.png?fileID=2800000&amp;guid=f7f681cd213d9a7488500ce745f2d4f8&amp;type=3#barmid_ready&apos;); flex-direction: column;">
            <ui:Label text="Choose a Character" display-tooltip-when-elided="true" class="color-default-text" style="-unity-font-style: bold; font-size: 28px; margin-top: 15px; -unity-text-align: upper-center;" />
            <ui:VisualElement style="align-items: center; flex-direction: row;">
                <ui:VisualElement name="Selectors" style="margin-left: 20px; margin-right: 10px; margin-top: 10px; margin-bottom: 20px; padding-left: 15px; padding-right: 15px; padding-top: 15px; padding-bottom: 15px; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/big_background.png?fileID=2800000&amp;guid=4edbc5539b441f049966c07e2ba12186&amp;type=3#big_background&apos;); flex-shrink: 0;">
                    <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1">
                        <ui:Instance template="UnitItem" name="UnitItem" />
                        <ui:Instance template="UnitItem" name="UnitItem" />
                        <ui:Instance template="UnitItem" name="UnitItem" />
                        <ui:Instance template="UnitItem" name="UnitItem" />
                        <ui:Instance template="UnitItem" name="UnitItem" />
                        <ui:Instance template="UnitItem" name="UnitItem" />
                        <ui:Instance template="UnitItem" name="UnitItem" />
                        <ui:Instance template="UnitItem" name="UnitItem" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="Content" style="background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/barmid_ready.png?fileID=2800000&amp;guid=f7f681cd213d9a7488500ce745f2d4f8&amp;type=3#barmid_ready&apos;); margin-left: 10px; margin-right: 40px; margin-bottom: 10px;">
                    <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" mode="Vertical" horizontal-scroller-visibility="Hidden" class="characterselect-cardlist">
                        <ui:VisualElement class="decklist">
                            <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                            <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                            <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                            <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                            <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                            <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="align-items: center; margin-bottom: 20px;">
                <ui:Button text="Select this Deck" display-tooltip-when-elided="true" name="ChooseDeck" class="button-menu" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
