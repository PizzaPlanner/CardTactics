                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
