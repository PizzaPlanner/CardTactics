<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="HubPlayerInfo" src="project://database/Assets/UI/HubPlayerInfo.uxml?fileID=9197481963319205126&amp;guid=00c96a331071cd3458cea425935fe024&amp;type=3#HubPlayerInfo" />
    <ui:Template name="CardBig" src="project://database/Assets/UI/CardBig.uxml?fileID=9197481963319205126&amp;guid=29a9371bab04ae14aa88f1bec4eb9fbc&amp;type=3#CardBig" />
    <Style src="project://database/Assets/UI/card.uss?fileID=7433441132597879392&amp;guid=01a2327da0d399347b2ae61c1337875e&amp;type=3#card" />
    <ui:VisualElement name="PlanningPanel" style="position: absolute; left: 0; top: 0; bottom: 0; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/Mini_background.png?fileID=2800000&amp;guid=4f033cdd2b09f9a43b139729d09d002c&amp;type=3#Mini_background&apos;); width: 20%; align-items: center; justify-content: space-between;">
        <ui:VisualElement />
        <ui:VisualElement name="PlayerInfo" style="justify-content: center;">
            <ui:Instance template="HubPlayerInfo" name="HubPlayerInfo" />
            <ui:Instance template="HubPlayerInfo" name="HubPlayerInfo" />
            <ui:Instance template="HubPlayerInfo" name="HubPlayerInfo" />
            <ui:Instance template="HubPlayerInfo" name="HubPlayerInfo" />
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" style="width: 100%; align-items: center; justify-content: flex-end; margin-bottom: 50px;">
            <ui:Label text="Map 1" display-tooltip-when-elided="true" name="MapName" class="color-default-text" style="font-size: 18px; -unity-font-style: bold;" />
            <ui:Label text="Label" display-tooltip-when-elided="true" name="CharacterCount" class="color-default-text" style="font-size: 16px;" />
            <ui:Button text="Go" display-tooltip-when-elided="true" name="Go" class="button-menu" style="width: 80%;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="MidAnchor" style="align-items: center; justify-content: center; left: 20%; position: absolute; right: 0; bottom: 0; top: 0;">
        <ui:VisualElement name="DeckSelect" style="align-items: stretch; width: 80%; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/barmid_ready.png?fileID=2800000&amp;guid=f7f681cd213d9a7488500ce745f2d4f8&amp;type=3#barmid_ready&apos;); flex-direction: column; height: 80%;">
            <ui:Label text="Choose a Character" display-tooltip-when-elided="true" picking-mode="Ignore" class="color-default-text" style="-unity-font-style: bold; font-size: 28px; margin-top: 15px; -unity-text-align: upper-center;" />
            <ui:VisualElement style="align-items: center; flex-direction: column;">
                <ui:VisualElement name="Selectors" style="margin-left: 20px; margin-right: 10px; margin-top: 10px; margin-bottom: 20px; padding-left: 15px; padding-right: 15px; padding-top: 15px; padding-bottom: 15px; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/big_background.png?fileID=2800000&amp;guid=4edbc5539b441f049966c07e2ba12186&amp;type=3#big_background&apos;); flex-shrink: 0; flex-direction: row; flex-wrap: wrap;" />
                <ui:VisualElement name="Content" style="background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/barmid_ready.png?fileID=2800000&amp;guid=f7f681cd213d9a7488500ce745f2d4f8&amp;type=3#barmid_ready&apos;); height: 80%; padding-bottom: 17px; padding-left: 17px; padding-right: 17px; padding-top: 17px;">
                    <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" mode="VerticalAndHorizontal" horizontal-scroller-visibility="Auto" class="characterselect-cardlist" style="width: 1250px;">
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
                        <ui:Instance template="CardBig" name="CardBig" style="align-items: auto;" />
