<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="UnitItemPlanning" src="project://database/Assets/UI/UnitItemPlanning.uxml?fileID=9197481963319205126&amp;guid=cff32862e11b4ed45a2121d13526a2b2&amp;type=3#UnitItemPlanning" />
    <ui:Template name="CardBig" src="project://database/Assets/UI/CardBig.uxml?fileID=9197481963319205126&amp;guid=29a9371bab04ae14aa88f1bec4eb9fbc&amp;type=3#CardBig" />
    <Style src="project://database/Assets/UI/card.uss?fileID=7433441132597879392&amp;guid=01a2327da0d399347b2ae61c1337875e&amp;type=3#card" />
    <ui:VisualElement name="Attachments" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
    <ui:VisualElement name="PlanningPanel" picking-mode="Ignore" style="position: absolute; bottom: 0; left: 0; right: 0; top: 0; align-items: flex-end; justify-content: space-between; flex-direction: row;">
        <ui:VisualElement name="CurrentUnit" style="flex-direction: row; position: relative; flex-shrink: 0; width: 400px;">
            <ui:Instance template="UnitItemPlanning" name="UnitItemPlanning" style="scale: 0.9 0.9;" />
            <ResourcePanel class="resource-panel--card" style="flex-direction: column; justify-content: flex-end; margin-bottom: 30px;">
                <ui:VisualElement class="resource-panel-group" style="flex-direction: row;">
                    <CostIcon />
                    <CostIcon />
                    <CostIcon />
                </ui:VisualElement>
            </ResourcePanel>
        </ui:VisualElement>
        <ui:VisualElement name="CardPanel" style="position: relative; align-items: flex-end; flex-direction: row; bottom: -200px; flex-shrink: 1; flex-grow: 0; justify-content: space-around; margin-right: 75px; margin-left: 75px;">
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
            <ui:Instance template="CardBig" name="CardBig" />
        </ui:VisualElement>
        <ui:VisualElement style="flex-shrink: 0; margin-bottom: 150px; width: 250px; margin-left: 150px;">
            <ui:Button text="End Turn" display-tooltip-when-elided="true" name="Confirm" class="button-menu" style="height: 100px; width: 200px;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement style="position: absolute; top: 0; align-items: center; justify-content: center; flex-direction: row; padding-top: 30px; left: 0; padding-left: 10px; right: 0;">
        <ui:VisualElement name="ReadyPanel" style="flex-direction: row; align-items: flex-start; justify-content: center;" />
    </ui:VisualElement>
    <ui:Instance template="CardBig" name="TooltipCard" style="position: absolute; right: 0; justify-content: center; top: 0; bottom: 0; padding-right: 20px;" />
    <ui:VisualElement name="TurnAnnouncer" style="position: absolute; top: 35%; left: 25%; right: 25%; height: 100px; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/name_bar3.png?fileID=21300000&amp;guid=12eaceb7341922b4398ff20c8bbcff90&amp;type=3#name_bar3&apos;); justify-content: center; opacity: 0.75; display: none;">
        <ui:Label text="Your Turn" display-tooltip-when-elided="true" class="color-default-text" style="-unity-text-align: middle-center; -unity-text-outline-width: 0; text-shadow: 2px 2px 2px rgb(0, 0, 0); font-size: 52px; word-spacing: 10px;" />
    </ui:VisualElement>
</ui:UXML>
