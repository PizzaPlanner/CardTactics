        <ui:VisualElement name="CardPanel" style="position: relative; align-items: flex-end; justify-content: center; flex-direction: row; padding-bottom: 10px; bottom: -200px;" />
        <ui:Button text="End Turn" display-tooltip-when-elided="true" name="Confirm" class="button-menu" style="position: absolute; bottom: 150px; right: 50px; height: 128px;" />
    </ui:VisualElement>
