    <ui:VisualElement name="TurnAnnouncer" style="position: absolute; top: 35%; left: 25%; right: 25%; height: 100px; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/name_bar3.png?fileID=21300000&amp;guid=12eaceb7341922b4398ff20c8bbcff90&amp;type=3#name_bar3&apos;); justify-content: center; opacity: 0.75;">
