<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Cards/UI/card.uss?fileID=7433441132597879392&amp;guid=01a2327da0d399347b2ae61c1337875e&amp;type=3#card" />
    <CardItem style="width: 240px; height: 440px; align-items: stretch;">
        <ui:VisualElement name="Background" style="flex-grow: 1; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/big_background.png?fileID=21300000&amp;guid=4edbc5539b441f049966c07e2ba12186&amp;type=3#big_background&apos;); padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <ui:VisualElement name="UpperPart" style="width: 240px; height: 240px; align-items: center; visibility: visible; border-bottom-width: 1px; border-bottom-color: rgba(89, 89, 61, 0.43);">
            <ui:VisualElement name="Icon" style="background-image: url(&apos;project://database/Assets/3rdParty/2000_Icons/Update_icons/skill_b_Standart/09_magic_bolt.png?fileID=21300000&amp;guid=aff477b2fab2d0542be64d8ea903698a&amp;type=3#09_magic_bolt&apos;); position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
            <ui:VisualElement name="CostRow" class="filter-actioncard" style="top: 4%; left: 4%; position: absolute; flex-direction: row;">
                <CostIcon name="CostIcon" class="cost-icon--big" />
                <CostIcon class="cost-icon--big" />
                <CostIcon class="cost-icon--big" />
                <CostIcon class="cost-icon--big" />
                <CostIcon class="cost-icon--big" />
                <CostIcon class="cost-icon--big" />
            </ui:VisualElement>
            <ui:Label text="This is the Card&apos;s Name" display-tooltip-when-elided="true" name="Name" class="color-default-text text-shadow" style="-unity-text-align: lower-center; white-space: normal; font-size: 22px; position: absolute; bottom: 0; -unity-font-style: bold; right: 5px; left: 5px;" />
        </ui:VisualElement>
        <ui:VisualElement name="LowerPart" style="flex-grow: 1; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 10px; align-items: center; justify-content: center; border-top-width: 1px; border-top-color: rgba(19, 19, 18, 0.78);">
            <ui:Label text="This text kind of describes what&apos;s going on." display-tooltip-when-elided="true" name="Description" class="color-default-text" style="-unity-text-align: upper-center; white-space: normal; font-size: 16px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Border" style="background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/Frame_big.png?fileID=21300000&amp;guid=c430351465fe1fc42a6bef5878a08253&amp;type=3#Frame_big&apos;); position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center;">
            <ui:VisualElement name="SpeedBackground" style="flex-direction: row; height: 8%; bottom: -3%; position: absolute; align-items: center; justify-content: center; font-size: 48px; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/Mini_background.png?fileID=2800000&amp;guid=4f033cdd2b09f9a43b139729d09d002c&amp;type=3#Mini_background&apos;); padding-left: 3px; padding-right: 3px; padding-top: 3px; padding-bottom: 3px;">
                <ui:Label text="100" display-tooltip-when-elided="true" name="Speed" class="color-default-text text-shadow" style="-unity-text-align: middle-center; white-space: nowrap; font-size: 28px;" />
            </ui:VisualElement>
            <ui:VisualElement name="Lifebar" class="filter-unitcard" style="width: 64px; height: 64px; position: absolute; bottom: -24px; background-image: url(&apos;project://database/Assets/3rdParty/2000_Icons/Update_icons/runic_tablet_12.png?fileID=21300000&amp;guid=9a55b94c8bace9e43855a800d07e5129&amp;type=3#runic_tablet_12&apos;); right: -24px;">
                <ui:Label text="21" name="Life" class="color-default-text text-shadow" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; font-size: 34px; -unity-font-style: bold; -unity-text-align: middle-center; padding-left: 3px; padding-right: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </CardItem>
</ui:UXML>
