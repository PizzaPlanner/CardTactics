<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Cards/UI/card.uss?fileID=7433441132597879392&amp;guid=01a2327da0d399347b2ae61c1337875e&amp;type=3#card" />
    <CardItem style="width: 260px; height: 440px; align-items: center;">
        <ui:VisualElement name="PlayText" class="helper-playcard" style="position: absolute; top: -40px; left: 0; right: 0; flex-direction: row; justify-content: center; align-items: center;">
            <ui:VisualElement style="background-image: url(&apos;project://database/Assets/3rdParty/Controller%20Icons%20Pack%20(by%20NullSave)/Textures/Filled/64/mouse_left.png?fileID=2800000&amp;guid=99015ae45bcdf27439bf40af93a1d817&amp;type=3#mouse_left&apos;); width: 24px; height: 24px;" />
            <ui:Label text="Play it" class="text-shadow color-default-text" style="-unity-font-style: bold; font-size: 18px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Background" style="flex-grow: 1; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/big_background.png?fileID=21300000&amp;guid=4edbc5539b441f049966c07e2ba12186&amp;type=3#big_background&apos;); padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <ui:VisualElement name="UpperPart" style="width: 100%; height: 100%; align-items: center; visibility: visible; border-bottom-width: 1px; border-bottom-color: rgba(89, 89, 61, 0.72); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-left-color: rgba(89, 89, 61, 0.72); border-right-color: rgba(89, 89, 61, 0.72); border-top-color: rgba(89, 89, 61, 0.72);">
            <ui:VisualElement name="Icon" style="background-image: url(&apos;project://database/Assets/3rdParty/2000_Icons/500_skillicons/Skill_standart/Druideskill_31.png?fileID=21300000&amp;guid=105cef2be8bfbb24999a39cdf37f7a03&amp;type=3#Druideskill_31&apos;); position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop;" />
        </ui:VisualElement>
        <ui:VisualElement name="LowerPart" style="align-items: stretch; justify-content: flex-end; -unity-background-scale-mode: stretch-to-fill; position: absolute; top: 0; bottom: 0; background-image: url(&apos;project://database/Assets/Card_Bottom_Fade.png?fileID=2800000&amp;guid=f77a6e8baeb9daa45b7bbf91f51feb98&amp;type=3#Card_Bottom_Fade&apos;); right: 0; left: 0; padding-bottom: 20px;">
            <ui:VisualElement name="StatsPanel" class="filter-unitcard" style="flex-direction: row; width: 100%; justify-content: space-around;">
                <ui:VisualElement name="Energy" style="flex-direction: row; align-items: center; justify-content: center; background-image: url(&apos;project://database/Assets/Icon_BG.png?fileID=2800000&amp;guid=55f4616714029ea488683c7e7dafcbe2&amp;type=3#Icon_BG&apos;); height: 64px; width: 64px;">
                    <ui:VisualElement style="position: absolute; left: 11px; top: 11px; right: 11px; bottom: 11px; background-image: url(&apos;project://database/Assets/3rdParty/2000_Icons/500_skillicons/Skill_nobg/Shamanskill_03_nobg.png?fileID=21300000&amp;guid=a132b637f97ce7e40a3e14cf8ea4eba2&amp;type=3#Shamanskill_03_nobg&apos;); rotate: 315deg;" />
                    <ui:Label text="8" name="Energy" class="color-default-text text-shadow-strong" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; font-size: 40px; -unity-text-align: middle-center; padding-left: 1px; padding-right: 0; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="Speed" style="flex-direction: row; align-items: center; justify-content: center; background-image: url(&apos;project://database/Assets/Icon_BG.png?fileID=2800000&amp;guid=55f4616714029ea488683c7e7dafcbe2&amp;type=3#Icon_BG&apos;); height: 64px; width: 64px;">
                    <ui:VisualElement style="position: absolute; left: 11px; top: 11px; right: 11px; bottom: 11px; background-image: url(&apos;project://database/Assets/3rdParty/2000_Icons/500_skillicons/Skill_nobg/Shamanskill_42_nobg.png?fileID=21300000&amp;guid=7945c694d9f570f4191734294855e361&amp;type=3#Shamanskill_42_nobg&apos;); rotate: 315deg;" />
                    <ui:Label text="8" name="Speed" class="color-default-text text-shadow-strong" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; font-size: 40px; -unity-text-align: middle-center; padding-left: 1px; padding-right: 0; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="Life" style="flex-direction: row; align-items: center; justify-content: center; background-image: url(&apos;project://database/Assets/Icon_BG.png?fileID=2800000&amp;guid=55f4616714029ea488683c7e7dafcbe2&amp;type=3#Icon_BG&apos;); height: 64px; width: 64px;">
                    <ui:VisualElement style="position: absolute; left: 11px; top: 11px; right: 11px; bottom: 11px; background-image: url(&apos;project://database/Assets/3rdParty/2000_Icons/500_skillicons/Skill_nobg/Shamanskill_11_nobg.png?fileID=21300000&amp;guid=5761acec9dccff2449af166d11290f34&amp;type=3#Shamanskill_11_nobg&apos;); rotate: 315deg;" />
                    <ui:Label text="8" name="Life" class="color-default-text text-shadow-strong" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; font-size: 40px; -unity-text-align: middle-center; padding-left: 1px; padding-right: 0; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; -unity-font-style: bold;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="NamePanel">
                <ui:Label text="This is some Name" display-tooltip-when-elided="true" name="Name" class="color-default-text" style="-unity-text-align: middle-center; white-space: nowrap; font-size: 25px; -unity-font-style: bold;" />
            </ui:VisualElement>
            <ui:VisualElement style="justify-content: flex-end;">
                <ui:Label text="This text kind of describes what&apos;s going on. Potentially verry long." display-tooltip-when-elided="true" name="Description" class="color-default-text" style="-unity-text-align: lower-center; white-space: normal; font-size: 18px; -unity-font-style: normal;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Border" style="background-image: url(&apos;project://database/Assets/Card_Border.png?fileID=21300000&amp;guid=248332c67d33f494ea5c899d68baa89e&amp;type=3#Card_Border&apos;); position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center;">
            <ui:VisualElement name="Energy" class="filter-actioncard" style="flex-direction: row; position: absolute; align-items: center; justify-content: center; background-image: url(&apos;project://database/Assets/Icon_BG.png?fileID=2800000&amp;guid=55f4616714029ea488683c7e7dafcbe2&amp;type=3#Icon_BG&apos;); height: 64px; width: 64px; top: -30px; left: 10px;">
                <ui:VisualElement style="position: absolute; left: 10px; top: 10px; right: 10px; bottom: 10px; background-image: url(&apos;project://database/Assets/3rdParty/2000_Icons/500_skillicons/Skill_nobg/Shamanskill_03_nobg.png?fileID=21300000&amp;guid=a132b637f97ce7e40a3e14cf8ea4eba2&amp;type=3#Shamanskill_03_nobg&apos;); rotate: 315deg;" />
                <ui:Label text="8" name="Energy" class="color-default-text text-shadow-strong" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; font-size: 40px; -unity-text-align: middle-center; padding-left: 1px; padding-right: 0; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; -unity-font-style: bold;" />
            </ui:VisualElement>
            <ResourcePanel class="filter-actioncard" style="position: absolute; left: -10px; top: 20px; scale: 0.75 0.75;">
                <CostIcon />
                <CostIcon />
                <CostIcon />
            </ResourcePanel>
        </ui:VisualElement>
    </CardItem>
</ui:UXML>
