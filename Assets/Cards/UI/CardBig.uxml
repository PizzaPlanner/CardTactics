<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Cards/UI/card.uss?fileID=7433441132597879392&amp;guid=01a2327da0d399347b2ae61c1337875e&amp;type=3#card" />
    <CardItem style="width: 260px; height: 440px; align-items: center;">
        <ui:VisualElement name="PlayText" class="helper-playcard" style="position: absolute; top: -40px; left: 0; right: 0; flex-direction: row; justify-content: center; align-items: center;">
            <ui:VisualElement style="background-image: url(&apos;project://database/Assets/3rdParty/Controller%20Icons%20Pack%20(by%20NullSave)/Textures/Filled/64/mouse_left.png?fileID=2800000&amp;guid=99015ae45bcdf27439bf40af93a1d817&amp;type=3#mouse_left&apos;); width: 24px; height: 24px;" />
            <ui:Label text="Play it" class="text-shadow color-default-text" style="-unity-font-style: bold; font-size: 18px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Background" style="flex-grow: 1; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/big_background.png?fileID=21300000&amp;guid=4edbc5539b441f049966c07e2ba12186&amp;type=3#big_background&apos;); padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <ui:VisualElement name="UpperPart" style="width: 100%; height: 60%; align-items: center; visibility: visible; border-bottom-width: 1px; border-bottom-color: rgba(89, 89, 61, 0.72); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-left-color: rgba(89, 89, 61, 0.72); border-right-color: rgba(89, 89, 61, 0.72); border-top-color: rgba(89, 89, 61, 0.72);">
            <ui:VisualElement name="Icon" style="background-image: url(&apos;project://database/Assets/3rdParty/2000_Icons/Update_icons/skill_b_Standart/27_Storm.png?fileID=21300000&amp;guid=35317befb39e4fc4481318346644df81&amp;type=3#27_Storm&apos;); position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop;" />
        </ui:VisualElement>
        <ui:VisualElement name="LowerPart" style="align-items: center; justify-content: center; -unity-background-scale-mode: stretch-to-fill; position: absolute; top: 0; bottom: 0; background-image: url(&apos;project://database/Assets/Card_Bottom.png?fileID=21300000&amp;guid=54cffe172801e6e4f9bf01116d97143c&amp;type=3#Card_Bottom&apos;); right: 0; left: 0;">
            <ui:VisualElement name="NamePanel" style="width: 100%; top: 70px; visibility: visible;">
                <ui:Label text="This is some Name" display-tooltip-when-elided="true" name="Name" class="color-default-text text-shadow" style="-unity-text-align: middle-center; white-space: nowrap; font-size: 25px; -unity-font-style: bold;" />
            </ui:VisualElement>
            <ui:VisualElement style="top: 309px; position: absolute; left: 5px; bottom: 10px; right: 5px; justify-content: center;">
                <ui:Label text="This text kind of describes what&apos;s going on. Potentially verry long." display-tooltip-when-elided="true" name="Description" class="color-default-text text-shadow" style="-unity-text-align: upper-center; white-space: normal; font-size: 18px; -unity-font-style: normal;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Border" style="background-image: url(&apos;project://database/Assets/Card_Border.png?fileID=21300000&amp;guid=248332c67d33f494ea5c899d68baa89e&amp;type=3#Card_Border&apos;); position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center;">
            <ui:VisualElement name="Cost" class="filter-actioncard" style="flex-direction: row; position: absolute; align-items: center; justify-content: center; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/lil_roundframe_ready.png?fileID=2800000&amp;guid=76a827c0b7b700d4fa9e135b970a64b1&amp;type=3#lil_roundframe_ready&apos;); height: 48px; width: 48px; top: 231px;">
                <ui:Label text="8" class="color-default-text" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; font-size: 32px; -unity-font-style: normal; -unity-text-align: middle-center; padding-left: 0; padding-right: 0; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="SpeedBackground" class="filter-unitcard" style="flex-direction: row; position: absolute; align-items: center; justify-content: center; font-size: 48px; background-image: url(&apos;project://database/Assets/3rdParty/2000_Icons/500_skillicons/Skill_nobg/Mageskill_20_nobg.png?fileID=2800000&amp;guid=27ca32c1f6077cc42bbae4a7a36f20fb&amp;type=3#Mageskill_20_nobg&apos;); height: 52px; width: 52px; left: -10px; bottom: -10px;">
                <ui:Label text="21" name="Speed" class="color-default-text text-shadow" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; font-size: 34px; -unity-font-style: bold; -unity-text-align: middle-center; padding-left: 3px; padding-right: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="Lifebar" class="filter-unitcard" style="width: 52px; height: 52px; position: absolute; bottom: -10px; background-image: url(&apos;project://database/Assets/3rdParty/2000_Icons/500_skillicons/Skill_nobg/Shamanskill_11_nobg.png?fileID=21300000&amp;guid=5761acec9dccff2449af166d11290f34&amp;type=3#Shamanskill_11_nobg&apos;); right: -10px;">
                <ui:Label text="21" name="Life" class="color-default-text text-shadow" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; font-size: 34px; -unity-font-style: bold; -unity-text-align: middle-center; padding-left: 3px; padding-right: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CostRow" class="filter-actioncard" style="position: absolute; flex-direction: row; justify-content: center; bottom: 0;">
            <CostIcon class="cost-icon--big" />
            <CostIcon class="cost-icon--big" />
            <CostIcon class="cost-icon--big" />
            <CostIcon class="cost-icon--big" />
            <CostIcon class="cost-icon--big" />
        </ui:VisualElement>
    </CardItem>
</ui:UXML>
