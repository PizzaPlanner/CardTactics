<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Cards/UI/card.uss?fileID=7433441132597879392&amp;guid=01a2327da0d399347b2ae61c1337875e&amp;type=3#card" />
    <UnitItem class="unit-item" style="width: 80px; height: 80px; align-items: center;">
        <ui:VisualElement name="Background" style="background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/Mini_background.png?fileID=21300000&amp;guid=4f033cdd2b09f9a43b139729d09d002c&amp;type=3#Mini_background&apos;); position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <ui:VisualElement name="Icon" style="background-image: url(&apos;project://database/Assets/3rdParty/2000_Icons/Update_icons/skill_b_Standart/09_magic_bolt.png?fileID=21300000&amp;guid=aff477b2fab2d0542be64d8ea903698a&amp;type=3#09_magic_bolt&apos;); position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <ui:VisualElement name="Border" class="unit-border" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);" />
        <ui:VisualElement name="Lifebar" class="filter-unitcard" style="position: absolute; bottom: -5px; background-image: url(&apos;project://database/Assets/bar_life.png?fileID=21300000&amp;guid=961b551b49b6ad9448387a3a498b8d2c&amp;type=3#bar_life&apos;); right: 10px; left: 10px; height: 15px; -unity-background-image-tint-color: rgb(70, 70, 70); display: none; -unity-background-scale-mode: stretch-to-fill; justify-content: center;">
            <ui:VisualElement name="Lifebar-Bar" style="background-image: url(&apos;project://database/Assets/bar_life.png?fileID=21300000&amp;guid=961b551b49b6ad9448387a3a498b8d2c&amp;type=3#bar_life&apos;); -unity-background-image-tint-color: rgb(255, 0, 0); -unity-background-scale-mode: stretch-to-fill; height: 100%; width: 100%;" />
            <ui:Label text="21" name="Life" class="color-default-text text-shadow" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; font-size: 24px; -unity-font-style: bold; -unity-text-align: middle-center; padding-bottom: 0; padding-top: 0; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 0;" />
        </ui:VisualElement>
        <ui:VisualElement name="Speed" style="background-image: url(&apos;project://database/Assets/NextArrow.png?fileID=2800000&amp;guid=6e925bfe92873ca4089d7f6a67f044c5&amp;type=3#NextArrow&apos;); position: absolute; bottom: -36px; -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 1; -unity-slice-right: 1; -unity-background-image-tint-color: rgb(77, 75, 70); width: 75%;">
            <ui:Label text="21" display-tooltip-when-elided="true" name="Speed" class="color-default-text text-shadow" style="font-size: 20px; padding-right: 15px; padding-left: 15px; padding-top: 0; padding-bottom: 0; -unity-text-align: middle-center;" />
        </ui:VisualElement>
