    <ui:VisualElement name="MidAnchor" style="left: 0; position: absolute; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center;">
        <ui:VisualElement name="DeckSelect" style="align-items: center; justify-content: flex-start; width: 80%; background-image: url(&apos;project://database/Assets/3rdParty/GUI_Parts/Gui_parts/barmid_ready.png?fileID=2800000&amp;guid=f7f681cd213d9a7488500ce745f2d4f8&amp;type=3#barmid_ready&apos;);">
